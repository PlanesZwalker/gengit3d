flowchart TD
    GIT["git log --topo-order<br/>+ refs (branches · stash · empty-branch tips)"]

    subgraph Shared["Shared pipeline — src/"]
        direction TB
        PARSER["gitlog.js — buildGraph()<br/>nodes · edges · branches · depth<br/>real-branch assignment (rev-list per ref)"]
        SIM["similar-commits.js — buildSimilarEdges()<br/>cherry-picks / same-subject links"]
        LAYOUT["layout3d.js — layoutGraphForView()<br/>topological · chronological · author<br/>radial · queue · real-branches<br/>(+ optional relax())"]
        COLORS["branch-colors.js — assignBranchColors()<br/>OKLab farthest-point palette"]
        THEMES["themes.js — 6 themes (dark + light)<br/>scene params + CSS chrome vars"]
    end

    subgraph Standalone["Standalone viewer"]
        direction TB
        CLI["bin/gengit3d.js — CLI + HTTP server<br/>parse → gengit3d.graph.json · serve · clean<br/>/api/graph · /api/clone · /api/repos · /api/commit"]
        PAGE["index.html — importmap → vendor/three/<br/>toolbar · legend + date filter · tips toggle<br/>local path / clone-URL input"]
        SCENEA["scene.js — renderGraph()<br/>InstancedMesh spheres + tube edges<br/>OrbitControls · raycast · tooltip<br/>fx: bloom / trails"]
        CLI -->|serves| PAGE --> SCENEA
    end

    subgraph VSC["VS Code extension"]
        direction TB
        HOST["extension.ts — extension host<br/>commands · parseRepo() · getCommitDetails()<br/>persists gengit3d.* settings"]
        WV["webview.ts — UI wiring<br/>toolbar · legend · detail panel + diff<br/>client-side re-layout (no git re-parse)"]
        SCENEV["scene-webview.ts — renderGraph()<br/>InstancedMesh · scale-0 node filters<br/>sliders: edges · nodes · space<br/>fx: bloom / trails"]
        HOST -->|postMessage graphData| WV --> SCENEV
    end

    GIT --> PARSER
    PARSER --> SIM --> LAYOUT

    LAYOUT --> CLI
    LAYOUT --> HOST

    COLORS --> SCENEA
    COLORS --> SCENEV
    THEMES --> PAGE
    THEMES --> WV

    classDef shared fill:#f39c12,color:#fff
    classDef standalone fill:#2ecc71,color:#fff
    classDef vscode fill:#9b59b6,color:#fff
    classDef source fill:#3498db,color:#fff
    class GIT source
    class PARSER,SIM,LAYOUT,COLORS,THEMES shared
    class CLI,PAGE,SCENEA standalone
    class HOST,WV,SCENEV vscode
